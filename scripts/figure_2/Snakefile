# Download censat for R2
rule download_censat:
    output:
        HG00673_censat="results/censat/HG00673_mat_hprc_r2_v1.cenSat.bed",
        HG01071_censat="results/censat/HG01071_mat_hprc_r2_v1.cenSat.bed",
    params:
        HG00673_uri="s3://human-pangenomics/working/HPRC/HG00673/assemblies/release2/annotation/censat/HG00673_mat_hprc_r2_v1.cenSat.bed",
        HG01071_uri="s3://human-pangenomics/working/HPRC/HG01071/assemblies/release2/annotation/censat/HG01071_mat_hprc_r2_v1.cenSat.bed",
    shell:
        """
        aws s3 cp {params.HG00673_uri} {output.HG00673_censat}
        aws s3 cp {params.HG01071_uri} {output.HG01071_censat}
        """

# Add sample_chrom prefix and coords to censat for plotting.
rule reformat_R2_censat_for_cenplot:
    input:
        HG00673_censat=rules.download_censat.output.HG00673_censat,
        HG01071_censat=rules.download_censat.output.HG01071_censat,
    output:
        HG00673_censat="results/censat/HG00673_mat_hprc_r2_v1.cenSat.cenmap.bed",
        HG01071_censat="results/censat/HG01071_mat_hprc_r2_v1.cenSat.cenmap.bed",
    shell:
        """
        grep "HG00673#2#JAHBBY020000044.1" {input.HG00673_censat} | \
            awk -v OFS="\\t" '{{$1="HG00673_R2_chr16_HG00673#2#JAHBBY020000044.1:15855520-24453678"; print}}' > {output.HG00673_censat}
        grep "HG01071#2#JAHBCE020000004.1" {input.HG01071_censat} | \
            awk -v OFS="\\t" '{{$1="HG01071_R2_chr6_HG01071#2#JAHBCE020000004.1:57355589-63686828"; print}}' > {output.HG01071_censat}
        """


# Clip regions to relative coordinates for liftover to R1 scaffold
# Note we'll use the original coordinates to plot.
rule reformat_censat_to_relative:
    input:
        HG00673_censat=rules.download_censat.output.HG00673_censat,
        HG01071_censat=rules.download_censat.output.HG01071_censat,
    output:
        HG00673_censat="results/censat/HG00673_mat_hprc_r2_v1.cenSat.relative.bed",
        HG01071_censat="results/censat/HG01071_mat_hprc_r2_v1.cenSat.relative.bed",
    shell:
        """
        bedtools intersect -a {input.HG00673_censat} -b <(printf "HG00673#2#JAHBBY020000044.1\\t15855520\\t24453678") | \
        awk -v OFS="\\t" '{{
            $2=$2-15855520; $3=$3-15855520;
            $1="HG00673_R2_chr16_HG00673#2#JAHBBY020000044.1:15855520-24453678";
            print
        }}' > {output.HG00673_censat}
        bedtools intersect -a {input.HG01071_censat} -b <(printf "HG01071#2#JAHBCE020000004.1\\t57355589\\t63686828") | \
        awk -v OFS="\\t" '{{
            $2=$2-57355589; $3=$3-57355589;
            $1="HG01071_R2_chr6_HG01071#2#JAHBCE020000004.1:57355589-63686828";
            print
        }}' > {output.HG01071_censat}
        """


rule subset_ctg:
    input:
        fa=lambda wc: FASTA[wc.ctg],
        bed="/project/logsdon_shared/projects/HPRC/CenMAP-R1vR2/exp/scripts/figure_2/regions.bed"
    output:
        "results/subset/{ctg}.fa"
    shell:
        """
        # In relative coordinates
        seqtk subseq {input.fa} <(cat {input.bed}) > {output}
        """

