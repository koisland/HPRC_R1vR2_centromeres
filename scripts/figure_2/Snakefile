# Liftover to R1 scaffold coordinates
rule liftover_to_R1:
    input:
        HG00673_paf=expand(rules.HG00673_H2_bam_to_paf.output, ref="HG00673_H2_release_2", sm="HG00673_H2_release_1"),
        HG00673_censat=rules.reformat_censat_to_relative.output.HG00673_censat,
        HG01071_paf=expand(rules.HG01071_H2_bam_to_paf.output, ref="HG01071_H2_release_2", sm="HG01071_H2_release_1"),
        HG01071_censat=rules.reformat_censat_to_relative.output.HG01071_censat,
    output:
        HG00673_R1_censat="results/censat/HG00673_mat_hprc_r1_v1.cenSat.relative.scaffold.bed",
        HG01071_R1_censat="results/censat/HG01071_mat_hprc_r1_v1.cenSat.relative.scaffold.bed",
    shell:
        """
        impg query -p {input.HG00673_paf} -b {input.HG00673_censat} | \
            sort -k7 | \
            join -1 7 -2 1 - <(sort -k4 {input.HG00673_censat} | cut -f 4,9) | \
            awk -v OFS="\\t" '{{ print $2, $3, $4, $1, 0, ".", $3, $4, $11 }}' | \
            sort -k1,1 -k2,2n -u > {output.HG00673_R1_censat}
        impg query -p {input.HG01071_paf} -b {input.HG01071_censat} | \
            sort -k7 | \
            join -1 7 -2 1 - <(sort -k4 {input.HG01071_censat} | cut -f 4,9) | \
            awk -v OFS="\\t" '{{ print $2, $3, $4, $1, 0, ".", $3, $4, $11 }}' | \
            sort -k1,1 -k2,2n -u > {output.HG01071_R1_censat}
        """


# Also run moddotplot. We don't include methylation yet... until someone asks me.
rule run_mdp:
    input:
        HG00673=rules.manual_scaffold.output.HG00673_R1_H2,
        HG01071=rules.manual_scaffold.output.HG01071_R1_H2,
    output:
        HG00673_bedpe="results/moddotplot/HG00673/HG00673_R1_H2:1-8986379.bed",
        HG01071_bedpe="results/moddotplot/HG01071/HG01071_R1_H2:1-6584374.bed",
    params:
        window=5000,
        thr_ident=86.0,
        HG00673_dir=lambda wc, output: dirname(output.HG00673_bedpe),
        HG01071_dir=lambda wc, output: dirname(output.HG01071_bedpe),
    shell:
        """
        censtats self-ident -i {input.HG00673} -o {params.HG00673_dir} -t {params.thr_ident} -x 2D -w {params.window}
        censtats self-ident -i {input.HG01071} -o {params.HG01071_dir} -t {params.thr_ident} -x 2D -w {params.window}
        """


OUTPUTS = [
    rules.HG00673_H2_all.input,
    rules.HG00673_H2_VIZ_ONLY_all.input,
    rules.HG01071_H2_all.input,
    rules.HG01071_H2_VIZ_ONLY_all.input,
    rules.download_censat.output,
    rules.reformat_censat_to_relative.output,
    rules.reformat_R2_censat_for_cenplot.output,
    rules.liftover_to_R1.output,
    rules.run_mdp.output,
]


rule draw_cenplots:
    input:
        all_outputs=OUTPUTS,
        bed="/project/logsdon_shared/projects/HPRC/CenMAP-R1vR2/exp/scripts/figure_2/regions.bed",
        cfg=lambda wc: CFG_CTGS[wc.ctg],
    output:
        directory("plots/{ctg}"),
    shell:
        """
        # In absolute coordinates
        chrom=$(grep {wildcards.ctg} {input.bed} | awk '{{
            match($1, "([0-9]+)-([0-9]+)$", coords);
            print $1":"$2+coords[1]"-"$3+coords[1]
        }}');
        cenplot draw -t {input.cfg} -c "${{chrom}}" -d {output}
        """


rule all:
    input:
        OUTPUTS,
        expand(rules.draw_cenplots.output, ctg=CFG_CTGS.keys())
    default_target: True
