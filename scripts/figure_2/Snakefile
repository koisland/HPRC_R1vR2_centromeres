def scaffold(name: str, infiles: list[str], outfile: str, scaffold_size: int = 100_000):
    with open(outfile, "wt") as ofh:
        print(f">{name}", file=ofh)
        for file in infiles:
            with open(file, "rt") as infh:
                for line in infh:
                    if line.startswith(">"):
                        continue
                    print(line.strip(), file=ofh, end="")
            print("N" * scaffold_size, file=ofh, end="")
    shell(f"samtools faidx {outfile}")


